<Project>

  <!--
    Settings that depend on properties from the csproj body (IsPackable) belong here, not in
    Directory.Build.props: .props is imported before the body runs, .targets after it.
  -->

  <!-- Every published package ships its XML docs; missing-doc warnings stay off until members are documented. -->
  <PropertyGroup Condition="'$(IsPackable)' == 'true'">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

</Project>
