<Project>

  <!--
    Shared build and pack settings for every project under src/. tests/ has its own
    Directory.Build.props, which stops MSBuild's upward search, so test projects inherit none of this.
  -->

  <PropertyGroup>
    <!-- One version for the whole solution. Kept in sync with pub/PubVersion.json by the CI bump on every publish. -->
    <Version>1.0.2</Version>
    <FileVersion>$([System.DateTime]::Now.ToString("yyyy.M.d.HHmm"))</FileVersion>
  </PropertyGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Shared package metadata; only Description stays per project. -->
    <Authors>GrayMint</Authors>
    <Copyright>GrayMint. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/graymint/GrayMint.Wallet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/graymint/GrayMint.Wallet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageIcon>GrayMint.Wallet.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\GrayMint.Wallet.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
