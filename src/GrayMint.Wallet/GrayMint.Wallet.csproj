<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<IsPackable>true</IsPackable>
		<Description>A double-entry ledger for PostgreSQL and SQL Server, with tables of its own in the host's database and calls that run in the host's own transaction: wallets, transfers that are never changed, pending amounts that are posted or voided, and limits that the database itself holds.</Description>
		<!-- The public API's docs ship in the package, and a public member without them fails the build. -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<WarningsAsErrors>$(WarningsAsErrors);CS1573;CS1574;CS1591</WarningsAsErrors>
	</PropertyGroup>

	<!-- No database provider: the host names its own, and the wallet works on the one it is given. -->
	<ItemGroup>
		<PackageReference Include="GrayMint.Common" Version="2.1.310" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.15" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.15" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="GrayMint.Wallet.Test" />
	</ItemGroup>

</Project>
